PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_hospital
# Optional integration-test URI; must target a separate database named with a "test" marker.
MONGODB_TEST_URI=
CLIENT_URL=http://localhost:4200
# Comma-separated list of allowed origins in production (optional; defaults to CLIENT_URL)
# CORS_ORIGINS=https://hospital.example.com,https://admin.hospital.example.com
JWT_SECRET=replace_with_a_secure_jwt_secret_key_here
JWT_EXPIRES_IN=1d
HOSPITAL_TIMEZONE=Asia/Kolkata
# Private, non-static document storage. Relative paths resolve from the backend directory.
# Keep this directory outside all Express-served/public directories; use a private volume in production.
VAULT_STORAGE_PATH=uploads/vault

# ------------------------------------------------------------------
# BOOTSTRAP CONFIGURATION (Milestone 3)
# Used ONLY by: npm run bootstrap (CLI script, never the HTTP server)
# Run once to create the initial CMO account with MANAGE_USERS.
# Remove these lines or leave them blank after bootstrapping.
# ------------------------------------------------------------------
BOOTSTRAP_CMO_EMAIL=cmo@smarthospital.local
BOOTSTRAP_CMO_NAME=Dr. Arthur Vance (CMO)
BOOTSTRAP_CMO_PASSWORD=replace_with_secure_bootstrap_password

# Used only by npm run seed. Set privately in backend/.env; never commit actual values.
DEMO_DOCTOR_PASSWORD=
DEMO_PHARMACY_PASSWORD=
DEMO_PATIENT_PASSWORD=
